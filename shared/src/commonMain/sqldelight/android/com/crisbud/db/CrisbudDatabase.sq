import android.com.crisbud.db.RecordKind;

CREATE TABLE Category (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  icon TEXT NOT NULL DEFAULT '•',
  kind INTEGER AS RecordKind NOT NULL DEFAULT 0 CHECK (kind IN (0, 1))
);

CREATE TABLE Wallet (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  name TEXT NOT NULL UNIQUE,
  balance REAL NOT NULL DEFAULT 0
);

CREATE TABLE Entries (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  category_id INTEGER REFERENCES Category(id) ON DELETE SET NULL,
  amount REAL NOT NULL,
  kind INTEGER AS RecordKind NOT NULL CHECK (kind IN (0, 1)),
  date TEXT NOT NULL,
  wallet_id INTEGER NOT NULL REFERENCES Wallet(id) ON DELETE RESTRICT,
  quantity INTEGER NOT NULL DEFAULT 1 CHECK (quantity > 0 AND (kind = 0 OR quantity = 1))
);

CREATE TABLE Budget (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  category_id INTEGER REFERENCES Category(id) ON DELETE SET NULL,
  month TEXT NOT NULL,
  limit_amount REAL NOT NULL,
  UNIQUE(category_id, month)
);

CREATE TABLE RecurringItem (
  id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  title TEXT NOT NULL,
  category_id INTEGER REFERENCES Category(id) ON DELETE SET NULL,
  amount REAL NOT NULL,
  due_day INTEGER NOT NULL,
  cadence TEXT NOT NULL DEFAULT 'Monthly',
  active INTEGER AS kotlin.Boolean NOT NULL DEFAULT 1
);

CREATE INDEX entries_category_kind_date ON Entries(category_id, kind, date);
CREATE INDEX entries_wallet ON Entries(wallet_id);
CREATE INDEX recurring_category ON RecurringItem(category_id);

selectTransactions:
SELECT e.id, e.title, c.name AS category, e.amount, e.kind, e.date, w.name AS wallet, e.quantity
FROM Entries e JOIN Wallet w ON w.id = e.wallet_id LEFT JOIN Category c ON c.id = e.category_id
WHERE :month IS NULL OR substr(e.date, 1, 7) = :month
ORDER BY e.date DESC, e.id DESC;

insertTransaction:
INSERT INTO Entries(id, title, category_id, amount, kind, date, wallet_id, quantity)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

updateTransaction:
UPDATE Entries SET title = ?, category_id = ?, amount = ?, kind = ?, date = ?, wallet_id = ?, quantity = ? WHERE id = ?;

deleteTransaction:
DELETE FROM Entries WHERE id = ?;

selectWallets:
SELECT * FROM Wallet ORDER BY name;

walletId:
SELECT id FROM Wallet WHERE name = ?;

walletNameConflictCount:
SELECT COUNT(*) FROM Wallet WHERE lower(name) = lower(?) AND name != ?;

updateWalletBalance:
UPDATE Wallet SET balance = ? WHERE name = ?;

ensureWallet:
INSERT OR IGNORE INTO Wallet(name) VALUES (?);

restoreWallet:
INSERT INTO Wallet(name, balance) VALUES (?, ?);

renameWallet:
UPDATE Wallet SET name = ? WHERE name = ?;

walletUsageCount:
SELECT COUNT(*) FROM Entries WHERE wallet_id = ?;

deleteWallet:
DELETE FROM Wallet WHERE id = ?;

selectCategories:
SELECT * FROM Category ORDER BY name;

categoryId:
SELECT id FROM Category WHERE name = ?;

ensureCategory:
INSERT OR IGNORE INTO Category(name, icon, kind) VALUES (?, ?, ?);

restoreCategory:
INSERT INTO Category(name, icon, kind) VALUES (?, ?, ?);

renameCategory:
UPDATE Category SET name = ? WHERE name = ?;

deleteCategory:
DELETE FROM Category WHERE id = ?;

selectBudgetsForMonth:
SELECT b.id, c.name AS category, b.month, b.limit_amount,
  COALESCE((SELECT SUM(e.amount * e.quantity) FROM Entries e
    WHERE e.category_id = b.category_id AND e.kind = 0
      AND substr(e.date, 1, 7) = b.month), 0.0) AS spent
FROM Budget b LEFT JOIN Category c ON c.id = b.category_id
WHERE b.month = ? ORDER BY c.name, b.id;

insertBudget:
INSERT OR REPLACE INTO Budget(category_id, month, limit_amount) VALUES (?, ?, ?);

restoreBudget:
INSERT INTO Budget(id, category_id, month, limit_amount) VALUES (?, ?, ?, ?);

updateBudget:
UPDATE Budget SET category_id = ?, limit_amount = ? WHERE id = ?;

deleteBudget:
DELETE FROM Budget WHERE id = ?;

selectRecurringItems:
SELECT r.id, r.title, c.name AS category, r.amount, r.due_day, r.cadence
FROM RecurringItem r LEFT JOIN Category c ON c.id = r.category_id
WHERE r.active = 1 ORDER BY r.due_day;

insertRecurringItem:
INSERT INTO RecurringItem(title, category_id, amount, due_day, cadence, active)
VALUES (?, ?, ?, ?, ?, 1);

restoreRecurringItem:
INSERT INTO RecurringItem(id, title, category_id, amount, due_day, cadence, active)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateRecurringItem:
UPDATE RecurringItem SET title = ?, category_id = ?, amount = ?, due_day = ? WHERE id = ?;

deleteRecurringItem:
UPDATE RecurringItem SET active = 0 WHERE id = ?;

exportBudgets:
SELECT b.id, c.name AS category, b.month, b.limit_amount
FROM Budget b LEFT JOIN Category c ON c.id = b.category_id ORDER BY b.month, c.name, b.id;

exportRecurringItems:
SELECT r.id, r.title, c.name AS category, r.amount, r.due_day, r.cadence, r.active
FROM RecurringItem r LEFT JOIN Category c ON c.id = r.category_id ORDER BY r.id;

clearEntries:
DELETE FROM Entries;

clearBudgets:
DELETE FROM Budget;

clearRecurringItems:
DELETE FROM RecurringItem;

clearCategories:
DELETE FROM Category;

clearWallets:
DELETE FROM Wallet;
